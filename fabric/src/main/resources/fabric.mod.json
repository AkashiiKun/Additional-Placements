{
  "schemaVersion": 1,
  "id": "additionalplacements",
  "version": "${version}",
  "name": "Additional Placements",
  "description": "Adds additional placements for blocks:\nSlabs can be placed vertically.\nStairs can be placed vertically.\nCarpets can be placed on walls and ceilings.\nPressure plates can be placed on walls and ceilings.",
  "authors": [
    "FirEmerald"
  ],
  "contact": {
    "homepage": ""
  },
  "license": "MIT",
  "icon": "assets/additionalplacements/textures/logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.firemerald.additionalplacements.common.fabric.FabricModEvents"
    ],
    "client": [
      "com.firemerald.additionalplacements.client.fabric.FabricModEvents"
    ],
    "additional-placements-generators": [
      "com.firemerald.additionalplacements.generation.APGenerationTypes"
    ]
  },
  "mixins": [
    "mixins.additionalplacements.json"
  ],
  "accessWidener" : "additionalplacements.accesswidener",
  "depends": {
    "fabricloader": ">=0.14.24",
    "minecraft": "~1.20.2",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
